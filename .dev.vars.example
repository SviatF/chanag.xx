# Local Cloudflare Worker variables.
# Keep real secrets in .dev.vars or Cloudflare dashboard secrets.

# Optional comma-separated supported city slugs approved for indexing beyond the 20-city launch baseline.
# Example: SEO_EXTRA_INDEX_CITIES=mysuru,kochi,dehradun
SEO_EXTRA_INDEX_CITIES=

# Optional comma-separated regional intent clusters approved after GSC demand review.
# Format: language:city:intent
# Supported intents: rahu-kalam, choghadiya
# The city must already be indexable and relevant to the selected regional language.
# Example: SEO_EXTRA_REGIONAL_INTENTS=tamil:coimbatore:rahu-kalam,malayalam:kochi:rahu-kalam
SEO_EXTRA_REGIONAL_INTENTS=

# Optional dedicated token for Cloudflare GraphQL analytics.
# Preferred over broadening the main worker/KV token.
# Required permission: Zone -> Analytics -> Read for the Panchvani zone.
CLOUDFLARE_ANALYTICS_API_TOKEN=

# SEO Opportunity Lifecycle + URL indexation inventory persistence.
# Uses CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN.
# The API token needs Workers KV Storage read/write permission for this namespace.
SEO_OPPORTUNITY_KV_NAMESPACE_ID=

# Gold Rate free-stack pipeline.
# The native pipeline uses gold-api.com for XAU/USD, a documented fallback spot endpoint,
# and Frankfurter/ECB for USD/INR. GOLD_RATE_DATA_URL is now only an optional external override.
GOLD_RATE_DATA_URL=
GOLD_RATE_DATA_TOKEN=

# Optional dedicated KV namespace. If blank, the pipeline reuses SEO_OPPORTUNITY_KV_NAMESPACE_ID
# with its own isolated storage key.
GOLD_RATE_KV_NAMESPACE_ID=

# Preferred dedicated API token for Gold Rate KV only.
# Grant Account -> Workers KV Storage -> Edit for the Panchvani Cloudflare account.
# If blank, code falls back to CLOUDFLARE_API_TOKEN for backward compatibility.
GOLD_RATE_KV_API_TOKEN=

# Public review can be enabled while every Gold Rate page remains noindex.
# Leave blank to auto-enable when a pipeline store or external data URL is configured.
GOLD_RATE_PUBLIC_ENABLED=

# FINAL GOLD RATE INDEXING GATE — do not switch to true until ALL are confirmed:
# [ ] >=14 continuous production days accumulated
# [ ] average IBJA deviation <=2%
# [ ] no validation day >5% deviation
# [ ] GOLD_RATE_INDEX_CITIES contains only cities approved via config/gold-rate-city-approvals.json
# [ ] sitemap-goldrate.xml manually checked after enabling and contains approved URLs only
# [ ] 3-5 random city pages manually QA'd (H1, direct answer, trend, methodology, bottom disclaimer)
# [ ] sitemap will be submitted separately in GSC and weekly monitoring starts immediately
# Full runbook: docs/gold-rate-indexing-readiness.md
GOLD_RATE_INDEXING_ENABLED=false
GOLD_RATE_MIN_VALIDATION_DAYS=14
GOLD_RATE_MIN_VALIDATION_OBSERVATIONS=10
GOLD_RATE_MAX_AGE_HOURS=24

# India pricing assumptions are deliberately configurable because duties/taxes can change.
# Baseline verified for Sep 2026: total gold import tariff 15%; GST on gold 3%.
GOLD_RATE_IMPORT_DUTY_RATE=0.15
GOLD_RATE_GST_RATE=0.03

# Optional JSON overrides for the documented city-premium estimate (0.00–0.01 only).
# Example: GOLD_RATE_CITY_PREMIUMS_JSON={"mumbai":0,"chennai":0.005}
GOLD_RATE_CITY_PREMIUMS_JSON=

# Demand-approved launch cities only. Maximum 50. Do not populate from population alone.
# Use scripts/approve-gold-rate-cities.mjs after a manual Google Trends demand review,
# then copy the exact GOLD_RATE_INDEX_CITIES=... line printed by the script.
GOLD_RATE_INDEX_CITIES=
