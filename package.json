{
  "name": "panchang-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:muhurat-precompute && vinext build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy",
    "cf-typegen": "wrangler types",
    "build:next": "npm run verify:muhurat-precompute && next build",
    "precompute:muhurat": "npx --yes tsx@4.23.13 scripts/precompute-muhurat.ts",
    "verify:muhurat-precompute": "npx --yes tsx@4.23.13 scripts/precompute-muhurat.ts --verify",
    "audit:content": "node scripts/content-quality-audit.mjs",
    "audit:content:strict": "node scripts/content-quality-audit.mjs --enforce-similarity",
    "audit:gsc-export": "node scripts/gsc-indexing-export-audit.mjs",
    "audit:seo-live": "node scripts/seo-live-response-audit.mjs",
    "audit:truth": "npx --yes tsx@4.23.13 scripts/content-integrity-audit.ts",
    "audit:festivals": "npx --yes tsx@4.23.13 scripts/festival-truth-audit.ts",
    "audit:muhurat": "npx --yes tsx@4.23.13 scripts/muhurat-truth-audit.ts",
    "audit:asta-evidence": "npx --yes tsx@4.23.13 scripts/asta-evidence-audit.ts",
    "research:asta-models": "npx --yes tsx@4.23.13 scripts/asta-observer-model-comparison.ts",
    "research:asta-visibility": "npx --yes tsx@4.23.13 scripts/asta-heliacal-visibility-research.ts",
    "research:asta-heliacal": "npx --yes tsx@4.23.13 scripts/asta-heliacal-visibility-research.ts --deep-heliacal",
    "audit:asta-methodology": "npx --yes tsx@4.23.13 scripts/asta-wave3q-reconciliation.ts",
    "audit:asta-angular-sources": "npx --yes tsx@4.23.13 scripts/asta-wave3r-angular-source-audit.ts",
    "audit:asta-city-sources": "npx --yes tsx@4.23.13 scripts/asta-wave3s-source-reproducibility.ts",
    "audit:ritual-evidence": "npx --yes tsx@4.23.13 scripts/wave3t-ritual-evidence-audit.ts",
    "audit:vrat-time-scale": "npx --yes tsx@4.23.13 scripts/wave3u-time-scale-audit.ts",
    "audit:boundary-integrity": "npx --yes tsx@4.23.13 scripts/wave3w-boundary-integrity-audit.ts",
    "audit:ekadashi-observance": "npx --yes tsx@4.23.13 scripts/wave3z-ekadashi-observance-audit.ts",
    "audit:sunrise-conventions": "npx --yes tsx@4.23.13 scripts/wave3ab-sunrise-source-audit.ts"
  },
  "dependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^0.468.0",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^5.7.2",
    "@typescriptify/sweph": "^1.0.4",
    "vinext": "1.0.0-beta.9",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "react-server-dom-webpack": "19.2.7"
  },
  "devDependencies": {
    "vitest": "^5.0.0",
    "vite": "^8.2.2",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "wrangler": "^4.130.0"
  },
  "type": "module"
}
