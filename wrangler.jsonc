{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panchang-xx",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "keep_vars": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "limits": {
    "cpu_ms": 100,
    "subrequests": 30
  },
  "triggers": {
    "crons": ["30 2 * * *", "17 * * * *"]
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  }
}
